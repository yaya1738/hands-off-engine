# Social Media API Credentials Template
# ======================================
# Copy this to .env.social and fill in your values
# These enable fully autonomous social media posting

# Twitter/X API Credentials
# Get from: https://developer.twitter.com/
TWITTER_BEARER_TOKEN=
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# Reddit API Credentials
# Get from: https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
REDDIT_USER_AGENT=hands-off-signals:v1.0 (by /u/YOUR_USERNAME)

# Polygonscan API (for payment verification)
# Get from: https://polygonscan.com/myapikey
POLYGONSCAN_API_KEY=

# Telegram (already configured if using setup script)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# WhatsApp Business Cloud API (configure only in private runtime secrets)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=
WHATSAPP_ALLOWED_RECIPIENTS=
WHATSAPP_OPTED_IN_RECIPIENTS=
