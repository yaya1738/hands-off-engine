# Polymarket CLOB API Configuration
# Copy this to .env.polymarket and fill in your actual values

# Required: Your Ethereum private key (with 0x prefix)
# This key signs orders and must match your Polymarket account
POLYMARKET_PRIVATE_KEY=0x...

# Required: Polymarket funder address (your funded wallet address)
# For email/Magic wallets, this may differ from the signing address
POLYMARKET_FUNDER_ADDRESS=0x...

# Optional: CLOB API endpoint (default: https://clob.polymarket.com)
POLYMARKET_CLOB_HOST=https://clob.polymarket.com

# Optional: Chain ID (default: 137 = Polygon mainnet)
POLYMARKET_CHAIN_ID=137

# Optional: Signature type (default: 1)
# 0 = EOA (MetaMask/hardware wallet)
# 1 = Email/Magic wallet
# 2 = Browser proxy
POLYMARKET_SIGNATURE_TYPE=1

# Global trading enable flag
# Set to "1" to enable LIVE trading (REAL MONEY!)
# Set to "0" to keep simulation mode (safe)
LIVE_TRADING_ENABLED=0

# Safety limits
MAX_POSITION_USD=1000
MAX_DAILY_LOSS_USD=3000
MAX_OPEN_RISK_USD=10000
