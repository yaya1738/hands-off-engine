{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Risk Configuration Schema",
  "description": "Schema for risk management parameters from RISK_MODEL_V1",
  "type": "object",
  "required": ["version", "position_sizing", "entry_thresholds", "daily_limits"],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "description": {
      "type": "string"
    },
    "position_sizing": {
      "type": "object",
      "required": ["max_position_size", "max_bankroll_fraction", "kelly_fraction_cap"],
      "properties": {
        "max_position_size": {
          "type": "number",
          "minimum": 0,
          "maximum": 10000
        },
        "max_bankroll_fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Maximum fraction of bankroll per position (0-1)"
        },
        "kelly_fraction_cap": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Maximum Kelly fraction allowed (0-1)"
        }
      }
    },
    "entry_thresholds": {
      "type": "object",
      "required": ["min_edge", "min_confidence", "price_boundaries"],
      "properties": {
        "min_edge": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Minimum edge required to enter trade (0-1)"
        },
        "min_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Minimum confidence threshold (0-1)"
        },
        "price_boundaries": {
          "type": "object",
          "required": ["min_price", "max_price"],
          "properties": {
            "min_price": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "max_price": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      }
    },
    "daily_limits": {
      "type": "object",
      "required": ["max_daily_risk", "max_positions", "circuit_breaker_loss"],
      "properties": {
        "max_daily_risk": {
          "type": "number",
          "minimum": 0
        },
        "max_positions": {
          "type": "integer",
          "minimum": 1
        },
        "circuit_breaker_loss": {
          "type": "number",
          "maximum": 0,
          "description": "Daily loss threshold that stops trading (negative value)"
        }
      }
    },
    "safety_layers": {
      "type": "object",
      "properties": {
        "alpha_filtering": {
          "type": "boolean"
        },
        "decider_constraints": {
          "type": "boolean"
        },
        "executor_validation": {
          "type": "boolean"
        },
        "circuit_breakers": {
          "type": "boolean"
        }
      }
    },
    "mode": {
      "type": "object",
      "properties": {
        "default": {
          "type": "string",
          "enum": ["DRYRUN", "LIVE"]
        },
        "live_requires_approval": {
          "type": "boolean"
        }
      }
    },
    "monitoring": {
      "type": "object",
      "properties": {
        "target_win_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "track_metrics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
