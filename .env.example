# Hands-Off Engine Environment Variables
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# ============================================================================
# API Keys (Required)
# ============================================================================

# OpenAI API Key - For AI Intake and planning
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# Anthropic API Key - For Claude-based agents
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Polymarket API Key (if using live trading)
# Get from: https://polymarket.com/
# POLYMARKET_API_KEY=your-polymarket-api-key-here

# ============================================================================
# GitHub Configuration (Required for AI Intake)
# ============================================================================

# GitHub Token - For workflow automation
# Should be set automatically in GitHub Actions
# GITHUB_TOKEN=ghp_your-token-here

# GitHub Repository (format: owner/repo)
# GITHUB_REPOSITORY=yaya1738/hands-off-engine

# AI Intake Issue Number (default: 1)
# AI_INTAKE_ISSUE_NUMBER=1

# ============================================================================
# Telegram Configuration (Optional)
# ============================================================================

# Telegram Bot Token
# Get from: @BotFather on Telegram
# TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Telegram Chat ID
# Your chat ID where notifications will be sent
# TELEGRAM_CHAT_ID=your-chat-id

# ============================================================================
# Configuration Overrides (Optional)
# Override any config value using: HO_<CONFIG>__<SECTION>__<KEY>=value
# Note: Use double underscores (__) to separate path components
# ============================================================================

# System Configuration Overrides
# HO_SYSTEM__SYSTEM__DEFAULT_MODE=DRYRUN
# HO_SYSTEM__SYSTEM__LOG_LEVEL=INFO

# Risk Configuration Overrides
# HO_RISK__POSITION_SIZING__MAX_POSITION_SIZE=100.0
# HO_RISK__POSITION_SIZING__MAX_BANKROLL_FRACTION=0.10
# HO_RISK__ENTRY_THRESHOLDS__MIN_EDGE=0.03
# HO_RISK__ENTRY_THRESHOLDS__MIN_CONFIDENCE=0.70
# HO_RISK__DAILY_LIMITS__MAX_DAILY_RISK=500.0
# HO_RISK__DAILY_LIMITS__MAX_POSITIONS=20
# HO_RISK__DAILY_LIMITS__CIRCUIT_BREAKER_LOSS=-200.0

# Trading Configuration Overrides
# HO_TRADING__EXECUTION__DEFAULT_MODE=DRYRUN
# HO_TRADING__DECISION_MAKING__BANKROLL_DEFAULT=1000.0

# Notification Configuration Overrides
# HO_NOTIFICATIONS__CHANNELS__TELEGRAM__ENABLED=true
# HO_NOTIFICATIONS__ALERT_TYPES__EXECUTION__NOTIFY_ON_DRYRUN=false

# Agent Configuration Overrides
# HO_AGENTS__DEFAULT_BACKEND=openai
# HO_AGENTS__ORCHESTRATION__BUDGET_PER_DAY_USD=10.0

# ============================================================================
# Development/Production Environment
# ============================================================================

# Environment (development, staging, production)
# ENVIRONMENT=development

# ============================================================================
# Database Configuration (Future)
# ============================================================================

# Database URL (when implemented)
# DATABASE_URL=postgresql://user:password@localhost:5432/handsoff

# ============================================================================
# Security Notes
# ============================================================================
# 
# 1. NEVER commit this file with real values to version control
# 2. Keep your API keys secure and rotate them regularly
# 3. Use different keys for development and production
# 4. Review access logs periodically
# 5. Enable LIVE mode only after thorough testing in DRYRUN
