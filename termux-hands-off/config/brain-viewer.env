# brain-viewer.env
# Environment variables specific to the brain viewer service
# Batch 26 Wiring v4

# HTTP server port for brain viewer
# This must NOT conflict with any existing viewer port
BRAIN_VIEWER_PORT=8091

# Host to bind to (localhost only for security)
BRAIN_VIEWER_HOST=127.0.0.1

# Viewer mode (read-only, no mutations)
BRAIN_VIEWER_READ_ONLY=true
