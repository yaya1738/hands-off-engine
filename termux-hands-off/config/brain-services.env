# brain-services.env
# Shared environment variables for all brain services
# Batch 26 Wiring v4

# Python virtual environment path (optional)
# If set, wrapper scripts will activate this venv before running Python
VENV_PATH=/root/hands-off-out/venv

# Python path for importing modules
# The runtime root should be in PYTHONPATH so 'app.brain.*' imports work
PYTHONPATH=/root/hands-off-out

# Brain state directory
# All brain services read/write state here
BRAIN_STATE_DIR=/root/hands-off-out/state

# Brain config file (global settings)
BRAIN_CONFIG_FILE=/root/hands-off-out/config/brain-config.json
