# paste:
# TELEGRAM_BOT_TOKEN=123456:ABC...
# TELEGRAM_CHAT_ID=123456789

chmod 600 "$HOME/hands-off/autopilot/telegram.env"
# test:
. "$HOME/hands-off/autopilot/telegram.env"; \
MSG="edge autopilot ok $(date -u +'%H:%MZ')" ; \
curl -s -X POST "https://api.telegram.org/bot${TELEGRAM_BOT_TOKEN}/sendMessage" \
 -d "chat_id=${TELEGRAM_CHAT_ID}" --data-urlencode "text=$MSG" \
 -d "disable_web_page_preview=true" >/dev/null && echo "[ok] telegram delivered"TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
