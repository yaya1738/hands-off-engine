# === Hands-Off Alert thresholds (inline comments allowed) ===
# Net-worth / total swing thresholds:
DELTA_THRESHOLD_USD="500"     # alert if |Δ| > $500
DELTA_THRESHOLD_PCT="1.5"     # alert if |Δ| > 1.5%

# Per-account swing thresholds (Schwab / PayPal / OKX / PM / etc.):
ACCOUNT_DELTA_USD="250"       # account-level |Δ| > $250
ACCOUNT_DELTA_PCT="3.0"       # account-level |Δ| > 3%

# Quiet hours (24h, comma-separated hours local time) — suppress non-critical:
QUIET_HOURS="0,1,2,3,4,5,6"   # 00:00–06:59

# Telegram + IFTTT are loaded from:
#   $HOME/hands-off/state/tg/bots/handsoff.env    (Termux)
#   /root/hands-off-out/state/tg.env              (DO) fallback
#   $HOME/hands-off/state/ifttt.env               (Termux)
#   /root/hands-off-out/state/ifttt.env           (DO) fallback

# --- Upgrades (v2) ---
# Always alert if absolute net delta exceeds this (ignores quiet hours):
CRITICAL_DELTA_USD="2000"     # set 0 to disable

# Cash buffer guardrails:
# Sum accounts whose name contains any of these (case-insensitive):
LIQUID_MATCH="cash,paypal,usdc,usdt"
# Minimum USD buffer required (absolute):
CASH_MIN_USD="500"            # set 0 to disable
# OR enforce a days-of-expenses floor:
DAILY_BURN_USD="75"           # average daily spend (USD), 0 to disable
CASH_MIN_DAYS="7"             # require at least this many days of cash

# --- v3 upgrades ---
# Suppress sending identical alerts within this window (minutes). 0 = off
SPAM_SHIELD_MIN="20"

# Keep up to this many alerts in the rolling log (jsonl) before truncation
ALERTS_LOG_MAX="500"
