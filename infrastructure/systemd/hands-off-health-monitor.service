[Unit]
Description=Hands-Off Engine Health Monitor
Documentation=https://github.com/yaya1738/hands-off-engine
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=user
Group=user
WorkingDirectory=/home/user/hands-off-engine
Environment="PYTHONUNBUFFERED=1"
Environment="PATH=/home/user/.local/bin:/usr/local/bin:/usr/bin:/bin"

# Run health checks every 60 seconds and publish metrics
ExecStart=/usr/bin/python3 /home/user/hands-off-engine/infrastructure/health_monitor.py --watch 60 --json

# Restart policy
Restart=always
RestartSec=30

# Resource limits
MemoryLimit=256M
CPUQuota=25%

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=hands-off-health

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=false
ReadWritePaths=/home/user/hands-off-engine/state

[Install]
WantedBy=multi-user.target
