[Unit]
Description=Hands-Off Engine Self-Healing Controller
Documentation=https://github.com/yaya1738/hands-off-engine
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=user
Group=user
WorkingDirectory=/home/user/hands-off-engine
Environment="PYTHONUNBUFFERED=1"
Environment="PATH=/home/user/.local/bin:/usr/local/bin:/usr/bin:/bin"

# Main process
ExecStart=/usr/bin/python3 /home/user/hands-off-engine/infrastructure/selfheal.py

# Restart policy
Restart=always
RestartSec=30
StartLimitBurst=5

# Resource limits
MemoryLimit=512M
CPUQuota=50%

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=hands-off-selfheal

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=false
ReadWritePaths=/home/user/hands-off-engine/state
ReadWritePaths=/var/log/hands-off-engine
ReadWritePaths=/tmp

# Process management
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
