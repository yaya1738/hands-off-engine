[Unit]
Description=Hands-Off Engine Server Sync Agent
Documentation=https://github.com/yaya1738/hands-off-engine
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/hands-off-engine
ExecStart=/usr/bin/python3 /root/hands-off-engine/scripts/server_sync_agent.py
Restart=always
RestartSec=60

# Environment variables for Telegram notifications
# Set these in /etc/environment or uncomment and fill in:
# Environment=TELEGRAM_BOT_TOKEN=your-token
# Environment=TELEGRAM_CHAT_ID=your-chat-id

# Logging
StandardOutput=append:/var/log/server-sync-agent.log
StandardError=append:/var/log/server-sync-agent.log

# Resource limits
MemoryMax=256M
CPUQuota=20%

[Install]
WantedBy=multi-user.target
