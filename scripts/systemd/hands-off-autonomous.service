[Unit]
Description=Hands-Off Engine Governed DASS Autonomous Service
Documentation=https://github.com/yaya1738/hands-off-engine
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/root/hands-off-engine
Environment="PATH=/usr/local/bin:/usr/bin:/bin"
Environment="PYTHONPATH=/root/hands-off-engine"
EnvironmentFile=-/etc/hands-off-engine.env

# Cloud provider credentials are supplied through the protected environment file.
# EnvironmentFile is intentionally optional so repository-native verification can run
# without credentials; live infrastructure mutation remains governed by the DASS
# authority path and fail-closed controls.

# Run the integrated DASS supervisor: phase selection, governed execution,
# continuous improvement, learning, and productive-capacity feedback are one loop.
ExecStart=/usr/bin/python3 /root/hands-off-engine/tools/autonomous_integrated_supervisor.py

Restart=always
RestartSec=10

StandardOutput=append:/var/log/hands-off/autonomous.log
StandardError=append:/var/log/hands-off/autonomous-error.log

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/root/hands-off-engine/logs
ReadWritePaths=/root/hands-off-engine/state
ReadWritePaths=/var/log/hands-off

[Install]
WantedBy=multi-user.target
